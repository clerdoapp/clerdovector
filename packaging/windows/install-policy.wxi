<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Choose scope before launch checks and directory costing. Never move an existing copy. -->
  <!-- Only for me leaves ALLUSERS unset. Publishing ALLUSERS=2 here makes FindRelatedProducts treat the run as
       per-machine and skip the existing per-user copy, so an interactive upgrade installs beside it
       (two registered products, and uninstall leaves files behind). Checked with real msiexec runs. -->
  <Property Id="INSTALLFOLDER" Secure="yes" />
  <Property Id="CLERDO_SCOPE" Value="user" Secure="yes" />
  <Property Id="CLERDO_U_DIR" Secure="yes"><RegistrySearch Id="CLERDO_U_DIRSearch" Root="HKCU" Key="Software\ClerdoVector" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="CLERDO_USER_DIR" Action="ClerdoUFromDIR" Value="[CLERDO_U_DIR]" After="AppSearch" Sequence="both" Condition="NOT CLERDO_USER_DIR AND CLERDO_U_DIR" />
  <Property Id="CLERDO_U_FOLDER" Secure="yes"><RegistrySearch Id="CLERDO_U_FOLDERSearch" Root="HKCU" Key="Software\ClerdoVector" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="CLERDO_USER_DIR" Action="ClerdoUFromFOLDER" Value="[CLERDO_U_FOLDER]" After="ClerdoUFromDIR" Sequence="both" Condition="NOT CLERDO_USER_DIR AND CLERDO_U_FOLDER" />
  <Property Id="CLERDO_U_PATH" Secure="yes"><RegistrySearch Id="CLERDO_U_PATHSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="CLERDO_USER_DIR" Action="ClerdoUFromPATH" Value="[CLERDO_U_PATH]" After="ClerdoUFromFOLDER" Sequence="both" Condition="NOT CLERDO_USER_DIR AND CLERDO_U_PATH" />
  <Property Id="CLERDO_U_EXEFOLDER" Secure="yes"><RegistrySearch Id="CLERDO_ULegacyFolder" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Type="file" /></Property>
  <Property Id="CLERDO_U_EXE" Secure="yes"><RegistrySearch Id="CLERDO_ULegacyExe" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Type="file"><FileSearch Id="CLERDO_ULegacyFile" Name="clerdovector.exe" /></RegistrySearch></Property>
  <SetProperty Id="CLERDO_USER_DIR" Action="ClerdoUFromLegacyExe" Value="[CLERDO_U_EXEFOLDER]" After="ClerdoUFromPATH" Sequence="both" Condition="NOT CLERDO_USER_DIR AND CLERDO_U_EXEFOLDER AND CLERDO_U_EXE" />
  <Property Id="CLERDO_USER_DIR" Secure="yes" />
  <Property Id="CLERDO_M_DIR" Secure="yes"><RegistrySearch Id="CLERDO_M_DIRSearch" Root="HKLM" Key="Software\ClerdoVector" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="CLERDO_MACHINE_DIR" Action="ClerdoMFromDIR" Value="[CLERDO_M_DIR]" After="ClerdoUFromLegacyExe" Sequence="both" Condition="NOT CLERDO_MACHINE_DIR AND CLERDO_M_DIR" />
  <Property Id="CLERDO_M_FOLDER" Secure="yes"><RegistrySearch Id="CLERDO_M_FOLDERSearch" Root="HKLM" Key="Software\ClerdoVector" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="CLERDO_MACHINE_DIR" Action="ClerdoMFromFOLDER" Value="[CLERDO_M_FOLDER]" After="ClerdoMFromDIR" Sequence="both" Condition="NOT CLERDO_MACHINE_DIR AND CLERDO_M_FOLDER" />
  <Property Id="CLERDO_M_PATH" Secure="yes"><RegistrySearch Id="CLERDO_M_PATHSearch" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="CLERDO_MACHINE_DIR" Action="ClerdoMFromPATH" Value="[CLERDO_M_PATH]" After="ClerdoMFromFOLDER" Sequence="both" Condition="NOT CLERDO_MACHINE_DIR AND CLERDO_M_PATH" />
  <Property Id="CLERDO_M_EXEFOLDER" Secure="yes"><RegistrySearch Id="CLERDO_MLegacyFolder" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Type="file" /></Property>
  <Property Id="CLERDO_M_EXE" Secure="yes"><RegistrySearch Id="CLERDO_MLegacyExe" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\clerdovector.exe" Type="file"><FileSearch Id="CLERDO_MLegacyFile" Name="clerdovector.exe" /></RegistrySearch></Property>
  <SetProperty Id="CLERDO_MACHINE_DIR" Action="ClerdoMFromLegacyExe" Value="[CLERDO_M_EXEFOLDER]" After="ClerdoMFromPATH" Sequence="both" Condition="NOT CLERDO_MACHINE_DIR AND CLERDO_M_EXEFOLDER AND CLERDO_M_EXE" />
  <Property Id="CLERDO_MACHINE_DIR" Secure="yes" />
  <SetProperty Id="CLERDO_SCOPE" Action="ClerdoPreferMachineScope" Value="machine" After="ClerdoMFromLegacyExe" Sequence="ui" Condition="ALLUSERS = 1 OR (CLERDO_MACHINE_DIR AND NOT CLERDO_USER_DIR)" />
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoRestoreUserFolder" Value="[CLERDO_USER_DIR]" Before="CostInitialize" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1 AND CLERDO_USER_DIR" />
  <!-- The wizard can change the context after Windows Installer has already resolved Program Files for the first one.
       Give the new-install folder explicitly so Everyone never lands in the profile and Only for me never lands in Program Files. -->
  <?if $(sys.BUILDARCH) = x86 ?>
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoDefaultMachineFolder" Value="[%ProgramFiles(x86)]\Clerdo\ClerdoVector\" After="ClerdoRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoDefaultMachineFolder32" Value="[%ProgramFiles]\Clerdo\ClerdoVector\" After="ClerdoDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND NOT VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Clerdo\ClerdoVector\" After="ClerdoDefaultMachineFolder32" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?else?>
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoDefaultMachineFolder" Value="[%ProgramW6432]\Clerdo\ClerdoVector\" After="ClerdoRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1" />
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Clerdo\ClerdoVector\" After="ClerdoDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?endif?>
  <SetProperty Id="INSTALLFOLDER" Action="ClerdoRestoreMachineFolder" Value="[CLERDO_MACHINE_DIR]" Before="ClerdoRestoreUserFolder" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND CLERDO_MACHINE_DIR" />
  <Launch Condition="Installed OR ALLUSERS &lt;&gt; 1 OR NOT CLERDO_USER_DIR" Message="This app is already installed for your account. Choose Only for me to update it, or uninstall that copy before changing who it is installed for." />
  <Launch Condition="Installed OR ALLUSERS = 1 OR NOT CLERDO_MACHINE_DIR" Message="This app is already installed for everyone. Choose Everyone to update it, or pass ALLUSERS=1 to msiexec. Uninstall that copy before changing who it is installed for." />
  <UI>
    <TextStyle Id="ClerdoScopeText" FaceName="Segoe UI" Size="9" />
    <TextStyle Id="ClerdoScopeTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
    <Dialog Id="ClerdoScopeDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\ClerdoScopeTitle}Who should use [ProductName]?" />
      <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="{\ClerdoScopeText}An update keeps the existing folder. New copies use the Clerdo folder under Programs." />
      <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="88" Width="330" Height="60" Property="CLERDO_SCOPE">
        <RadioButtonGroup Property="CLERDO_SCOPE">
          <RadioButton Value="user" X="0" Y="0" Width="330" Height="20" Text="Only for me (no administrator permission needed)" />
          <RadioButton Value="machine" X="0" Y="30" Width="330" Height="20" Text="Everyone on this computer (asks an administrator)" />
        </RadioButtonGroup>
      </Control>
      <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="Next">
        <Publish Property="ALLUSERS" Value="1" Order="1" Condition="CLERDO_SCOPE = &quot;machine&quot;" />
        <Publish Property="ALLUSERS" Value="{}" Order="2" Condition="CLERDO_SCOPE = &quot;user&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="3" Condition="CLERDO_SCOPE = &quot;machine&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="1" Order="4" Condition="CLERDO_SCOPE = &quot;user&quot;" />
        <Publish Event="EndDialog" Value="Return" Order="5" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
    </Dialog>
  </UI>
  <InstallUISequence>
    <Show Dialog="ClerdoScopeDlg" After="ClerdoPreferMachineScope" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    <!-- Related-product discovery runs once, so full UI must choose its context first. -->
    <FindRelatedProducts After="ClerdoScopeDlg" />
  </InstallUISequence>
</Include>
